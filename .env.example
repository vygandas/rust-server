# Rust aux01 Staging Server Configuration
# Copy this file to .env and customize your settings

# === BRANCH CONFIGURATION ===
# IMPORTANT: aux01-staging is the staging branch for testing new features
RUST_BRANCH=-beta aux01-staging
RUST_BRANCH_PASSWORD=
RUST_UPDATE_ON_START=true

# === SERVER IDENTITY ===
RUST_SERVER_IDENTITY=aux01_staging_test
RUST_SERVER_HOSTNAME=BnF aux01 Staging Test Server
RUST_SERVER_DESCRIPTION=Blood & Fire - Testing aux01 staging branch features
RUST_SERVER_URL=
RUST_SERVER_BANNER=
RUST_SERVER_LOGO=

# === NETWORK CONFIGURATION ===
RUST_SERVER_IP=0.0.0.0
RUST_SERVER_PORT=28015
RUST_QUERY_PORT=28017
RUST_RCON_IP=0.0.0.0
RUST_RCON_PORT=28016
# IMPORTANT: Change this password!
RUST_RCON_PASSWORD=ChangeThisSecurePassword123!
RUST_RCON_WEB=1
RUST_APP_PORT=28082
# Set your public IP for Rust+ app (leave empty for auto-detect)
RUST_APP_PUBLICIP=

# === WORLD CONFIGURATION ===
RUST_SERVER_LEVEL=Procedural Map
# Change seed for different map generation
RUST_SERVER_SEED=1337
# World size: 1000-6000 (3500 is good for testing)
RUST_SERVER_WORLDSIZE=3500
# Maximum concurrent players
RUST_SERVER_MAXPLAYERS=100

# === PERFORMANCE SETTINGS ===
# Server tick rate (10-30, higher = better performance but more CPU)
RUST_SERVER_TICKRATE=30
# Auto-save interval in seconds
RUST_SERVER_SAVE_INTERVAL=300

# === GAMEPLAY SETTINGS ===
RUST_SERVER_GLOBALCHAT=true
# PvE mode (false = PvP, true = PvE)
RUST_SERVER_PVE=false
RUST_SERVER_STABILITY=true
# Decay settings (set DECAY_SCALE to 0 to disable decay for testing)
RUST_DECAY_TICK=300
RUST_DECAY_SCALE=1

# === SECURITY & ANTI-CHEAT ===
# EAC enabled (set to false for testing/development only)
RUST_SERVER_SECURE=true
# Network encryption level (0-2, 2 = highest)
RUST_SERVER_ENCRYPTION=2
RUST_ANTICHEAT_LOG=1

# === MODDING FRAMEWORKS ===
# Enable Oxide/uMod for plugins
RUST_OXIDE_ENABLED=false
# Enable Carbon (alternative to Oxide)
RUST_CARBON_ENABLED=false

# === SERVER BROWSER TAGS ===
# Comma-separated tags for server browser
RUST_SERVER_TAGS=staging,aux01,testing,bnf

# === LOGGING ===
RUST_LOG_FILE=/home/steam/rust_server/server_data/server.log

# === RCON WEB INTERFACE ===
# Credentials for the web-based RCON interface
RWA_USERNAME=admin
RWA_PASSWORD=changeme
RWA_ADMIN=true